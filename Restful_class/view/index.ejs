<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=<device-width>, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <h1>Quora post</h1>
    <%for(post of posts){%>
        <div class="post">
            <h2 class="user">username :@<%=post.username%>
            </h2>
            <h2 class="content">content : <%=post.content%>
            </h2>
            <h4><a href="http://localhost:3000/posts/<%=post.id%>">view in detail</a></h4>
            <h4><a href="http://localhost:3000/posts/<%=post.id%>/new">edit post</a></h4>
            <form method="post" action="/posts/<%=post.id%>?_method=DELETE">
                <button>remove</button>
            </form>
        </div>

        <%}%>

            <a href="http://localhost:3000/posts/new">add p</a>
</body>

</html>